# API host (no trailing slash). Used for production builds and as the dev proxy target.
VITE_API_BASE_URL=https://test.taswouk.com

# Dev only: set to false to call VITE_API_BASE_URL directly from the browser (needs CORS on the API).
# Default true — requests go to /api on localhost and Vite proxies to the target below.
# VITE_USE_DEV_PROXY=false

# Optional: override proxy target in dev (defaults to VITE_API_BASE_URL, then https://test.taswouk.com).
# VITE_DEV_API_PROXY_TARGET=https://test.taswouk.com

# Authorization scheme for API requests (default Bearer).
# VITE_AUTH_SCHEME=JWT

# Optional: override admin “create seller” path (default POST /api/accounts/admin/users/seller per OpenAPI).
# VITE_ADMIN_CREATE_SELLER_PATH=/api/accounts/admin/users/seller

# Optional: override admin “list sellers” endpoint used by searchable seller dropdowns.
# VITE_ADMIN_LIST_SELLERS_PATH=/api/accounts/admin/users/sellers

# Categories endpoints (defaults shown from current docs):
# VITE_CATEGORIES_TREE_PATH=/api/products/categories/tree
# VITE_CATEGORY_CREATE_PATH=/api/products/categories
# VITE_CATEGORY_DETAIL_PATH_TEMPLATE=/api/products/categories/{id}

# Optional: multipart upload path for product images; `{id}` is replaced with the product id (default below).
# VITE_PRODUCT_IMAGE_UPLOAD_PATH_TEMPLATE=/api/products/{id}/images

# Optional: DELETE path for one image; `{productId}` and `{imageId}` replaced (default below).
# VITE_PRODUCT_IMAGE_DELETE_PATH_TEMPLATE=/api/products/{productId}/images/{imageId}

# Form field name for file(s) on POST .../images (default: `images` per OpenAPI / FastAPI).
# VITE_PRODUCT_IMAGE_FORM_FIELD=images

# Product category payload mode:
# - name (default): send selected category/subcategory names
# - id: send selected category/subcategory ids
# VITE_PRODUCT_CATEGORY_VALUE_MODE=name

# GET path for stored image paths (must NOT collide with `/api/products/{product_id:int}`).
# Default: `/media/{path}` → e.g. `products/logo.png` → `/media/products/logo.png`
# Placeholders: `{path}`, `{basename}`, `{productId}`
# VITE_PRODUCT_IMAGE_GET_PATH_TEMPLATE=/media/{path}

# Origin when building absolute URLs (optional).
# VITE_PUBLIC_MEDIA_BASE_URL=https://test.taswouk.com
# VITE_MEDIA_PATH_PREFIX=
