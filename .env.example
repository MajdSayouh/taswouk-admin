# API host (no trailing slash). Used for production builds and as the dev proxy target.
VITE_API_BASE_URL=https://test.taswouk.com

# Dev only: set to false to call VITE_API_BASE_URL directly from the browser (needs CORS on the API).
# Default true — requests go to /api on localhost and Vite proxies to the target below.
# VITE_USE_DEV_PROXY=false

# Optional: override proxy target in dev (defaults to VITE_API_BASE_URL, then https://test.taswouk.com).
# VITE_DEV_API_PROXY_TARGET=https://test.taswouk.com

# Authorization scheme for API requests (default Bearer).
# VITE_AUTH_SCHEME=JWT

# Optional: override admin “create seller” path (default POST /api/accounts/admin/users/seller per OpenAPI).
# VITE_ADMIN_CREATE_SELLER_PATH=/api/accounts/admin/users/seller

# Optional: override admin “list sellers” endpoint used by searchable seller dropdowns.
# VITE_ADMIN_LIST_SELLERS_PATH=/api/accounts/admin/users/sellers

# Optional: PUT/DELETE seller by id; `{sellerId}` replaced (default: /api/accounts/admin/users/seller/{sellerId}).
# VITE_ADMIN_SELLER_BY_ID_PATH_TEMPLATE=/api/accounts/admin/users/seller/{sellerId}

# Categories endpoints (defaults shown from current docs):
# VITE_CATEGORIES_TREE_PATH=/api/products/categories/tree
# VITE_CATEGORY_CREATE_PATH=/api/products/categories
# VITE_CATEGORY_DETAIL_PATH_TEMPLATE=/api/products/categories/{id}
# Optional: POST/DELETE category logo; `{id}` replaced (default below).
# VITE_CATEGORY_LOGO_PATH_TEMPLATE=/api/products/categories/{id}/logo

# Optional: multipart upload path for product images; `{id}` is replaced with the product id (default below).
# VITE_PRODUCT_IMAGE_UPLOAD_PATH_TEMPLATE=/api/products/{id}/images

# Optional: DELETE path for one image; `{productId}` and `{imageId}` replaced (default below).
# VITE_PRODUCT_IMAGE_DELETE_PATH_TEMPLATE=/api/products/{productId}/images/{imageId}

# Optional: PATCH path to set featured/cover image (same placeholders as DELETE).
# VITE_PRODUCT_IMAGE_SET_FEATURED_PATH_TEMPLATE=/api/products/{productId}/images/{imageId}/set-featured

# Form field name for file(s) on POST .../images (default: `images` per OpenAPI / FastAPI).
# VITE_PRODUCT_IMAGE_FORM_FIELD=images

# Optional: multipart upload path for product video; `{productId}` or `{id}` is replaced.
# VITE_PRODUCT_VIDEO_UPLOAD_PATH_TEMPLATE=/api/products/{productId}/videos

# Form field name for POST .../videos. Defaults to `video`; code retries `file` on 400/422.
# VITE_PRODUCT_VIDEO_FORM_FIELD=video

# Product PUT workaround when API returns ProductUpdateSchema has no field "category":
# Omit category_id on update (category changes will not persist until the API is fixed).
# VITE_PRODUCT_UPDATE_OMIT_CATEGORY_ID=true

# GET path for stored image paths (must NOT collide with `/api/products/{product_id:int}`).
# Default: `/media/{path}` → e.g. `products/logo.png` → `/media/products/logo.png`
# Placeholders: `{path}`, `{basename}`, `{productId}`
# VITE_PRODUCT_IMAGE_GET_PATH_TEMPLATE=/media/{path}

# Origin when building absolute URLs (optional).
# VITE_PUBLIC_MEDIA_BASE_URL=https://test.taswouk.com
# VITE_MEDIA_PATH_PREFIX=

# Mall categories (defaults from API docs → Mall Categories):
# VITE_MALL_CATEGORIES_TREE_PATH=/api/malls/categories/tree
# VITE_MALL_CATEGORY_CREATE_PATH=/api/malls/categories
# VITE_MALL_CATEGORY_DETAIL_PATH_TEMPLATE=/api/malls/categories/{id}
# VITE_MALL_CATEGORY_TOGGLE_ACTIVE_PATH_TEMPLATE=/api/malls/categories/{id}/toggle-active
# VITE_MALL_CATEGORY_LOGO_PATH_TEMPLATE=/api/malls/categories/{id}/logo
# VITE_MALL_CATEGORY_MOVE_PATH_TEMPLATE=/api/malls/categories/{id}/move

# External shops (defaults from API docs → External Shops):
# VITE_EXTERNAL_SHOPS_LIST_PATH=/api/external-shops/
# VITE_EXTERNAL_SHOP_DETAIL_PATH_TEMPLATE=/api/external-shops/{id}
# VITE_EXTERNAL_SHOP_LOGO_PATH_TEMPLATE=/api/external-shops/{id}/logo

# Firebase Web (FCM) — public keys; keep `public/firebase-messaging-sw.js` in sync when project/app IDs change.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate (Firebase Console → Project settings → Cloud Messaging).
# Required for admin new-order toasts while the dashboard tab is open.
# VITE_FIREBASE_VAPID_KEY=
# Optional: device registration (POST RegisterDeviceSchema — see API Docs → Devices).
# Default: /api/accounts/devices
# Body: { device_token, device_type: "android"|"ios"|"web", fcm_token? }
# VITE_FCM_DEVICES_PATH=/api/accounts/devices
# Backward-compat alias:
# VITE_FCM_REGISTER_PATH=/api/accounts/devices

# Dev: log FCM registration token + payload logs to the browser console (Firebase Console → test send needs this token).
# VITE_FCM_DEBUG=true
